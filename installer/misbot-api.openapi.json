{
  "openapi": "3.1.0",
  "info": {
    "title": "Misbot instance protocol",
    "version": "1",
    "description": "Misbot protocol; not Matrix. Local administrator methods exist only on root CLI and dedicated UID Unix RPC. No remote admin access."
  },
  "servers": [
    {
      "url": "https://example.org"
    }
  ],
  "paths": {
    "/.well-known/misbot": {
      "get": {
        "summary": "Public origin-bound discovery",
        "responses": {
          "200": {
            "description": "Discovery",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Discovery"
                }
              }
            }
          },
          "429": {
            "description": "rate_limit"
          },
          "503": {
            "description": "api_disabled, or installation_busy_or_pending: preserve checkpoint and retry after enabling API or recovery"
          }
        }
      }
    },
    "/_misbot/v1/exchange": {
      "post": {
        "summary": "Authenticated peer request/status/decision/cancellation",
        "description": "Sign every request. Nonce replay protection and UTC timestamp within 300 seconds. Max body 32768 bytes. A remote decision never substitutes local approval. Response signature and reply_to must be verified. New invitations expire in 30 days. At most one active request per peer. Persistent creation limit: one outgoing invite per minute; receiver enforces one new invite per peer per minute. Expiry and cancellation never remove applied policies. Unknown cancellation creates a replay tombstone. Before creating or posting a new invite, sender verifies HTTPS discovery, protocol, fixed API path, pinned identity, federation-invites capability and 30-day lifetime. Matrix without Misbot, unavailable discovery or missing capability is never a fallback destination.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed result, not evidence of Matrix room federation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "400": {
            "description": "Safe code: invalid_signature, signature_identity, unsupported_version, expired_request, replay, request_owner, invalid_request, request_not_found, remote_operation_denied, request_capacity, invalid_expiration, invalid_transition, pending_request_exists, invitation_rate_limit, peer_already_connected",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "rate_limit"
          },
          "503": {
            "description": "api_disabled, or installation_busy_or_pending: preserve checkpoint and retry after enabling API or recovery"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Discovery": {
        "type": "object",
        "required": [
          "protocol",
          "instance_id",
          "server_name",
          "bot_mxid",
          "api_path",
          "algorithm",
          "public_key",
          "key_id"
        ],
        "properties": {
          "protocol": {
            "type": "integer",
            "const": 1
          },
          "instance_id": {
            "type": "string"
          },
          "server_name": {
            "type": "string"
          },
          "bot_mxid": {
            "type": "string"
          },
          "api_path": {
            "type": "string"
          },
          "algorithm": {
            "type": "string"
          },
          "public_key": {
            "type": "string"
          },
          "key_id": {
            "type": "string"
          },
          "request_ttl": {
            "type": "integer",
            "minimum": 604800,
            "maximum": 2592000,
            "description": "Optional for legacy readers. New thirty-day invitations require 2592000 and capabilities containing federation-invites."
          },
          "capabilities": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "description": "Optional for legacy protocol1 readers. New invitations require federation-invites together with request_ttl=2592000. Enabled Misbot API advertises this capability by default.",
            "examples": [
              [
                "federation-invites"
              ]
            ]
          }
        }
      },
      "Request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "payload",
          "signature"
        ],
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "protocol",
              "sender",
              "instance_id",
              "recipient",
              "recipient_instance",
              "timestamp",
              "nonce",
              "method",
              "path",
              "body"
            ],
            "properties": {
              "protocol": {
                "type": "integer",
                "const": 1
              },
              "sender": {
                "type": "string"
              },
              "instance_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              "recipient": {
                "type": "string"
              },
              "recipient_instance": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              "timestamp": {
                "type": "integer"
              },
              "nonce": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              "method": {
                "type": "string",
                "const": "POST"
              },
              "path": {
                "type": "string",
                "const": "/_misbot/v1/exchange"
              },
              "body": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action",
                  "request_id",
                  "expires_at",
                  "approved",
                  "applied"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "invite",
                      "status",
                      "decision",
                      "rejected",
                      "cancelled"
                    ]
                  },
                  "request_id": {
                    "type": "string",
                    "pattern": "^MB-[0-9a-f]{32}$"
                  },
                  "expires_at": {
                    "type": "integer"
                  },
                  "approved": {
                    "type": "boolean"
                  },
                  "applied": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          "signature": {
            "type": "string",
            "description": "Base64 RSA-3072/SHA256 PKCS#1 v1.5 signature of canonical payload"
          }
        }
      },
      "Response": {
        "type": "object",
        "required": [
          "payload",
          "signature"
        ],
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "protocol",
              "sender",
              "instance_id",
              "recipient",
              "recipient_instance",
              "timestamp",
              "nonce",
              "method",
              "path",
              "body"
            ],
            "properties": {
              "protocol": {
                "type": "integer",
                "const": 1
              },
              "sender": {
                "type": "string"
              },
              "instance_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              "recipient": {
                "type": "string"
              },
              "recipient_instance": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              "timestamp": {
                "type": "integer"
              },
              "nonce": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              "method": {
                "type": "string",
                "const": "POST"
              },
              "path": {
                "type": "string",
                "const": "/_misbot/v1/exchange"
              },
              "body": {
                "type": "object",
                "required": [
                  "request_id",
                  "reply_to",
                  "state",
                  "approved",
                  "applied"
                ],
                "properties": {
                  "request_id": {
                    "type": "string",
                    "pattern": "^MB-[0-9a-f]{32}$"
                  },
                  "reply_to": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{32}$"
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "pending",
                      "accepted",
                      "applying",
                      "partially_applied",
                      "connected",
                      "rejected",
                      "expired",
                      "cancelled"
                    ]
                  },
                  "approved": {
                    "type": "boolean"
                  },
                  "applied": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "signature": {
            "type": "string",
            "description": "Base64 RSA-3072/SHA256 PKCS#1 v1.5 signature of canonical payload"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
