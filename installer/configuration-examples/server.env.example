# Copy to settings/server.env, root:root 0600. Replace the fictional domain.
DOMAIN=example.org
# Empty uses DOMAIN as the website and public service-name base.
PUBLIC_DOMAIN=
# Empty uses web.<PUBLIC_DOMAIN> (or web.<DOMAIN>).
WEB_DOMAIN=
# Optional additional bare LiveKit SFU hostname, for an existing public address.
SFU_DOMAIN=
# Empty uses mas.<PUBLIC_DOMAIN>; choose the existing issuer hostname before first start.
MAS_DOMAIN=
PUBLIC_IP=
ACME_EMAIL=
MEDIA_MODE=local
POSTGRES_MODE=local
